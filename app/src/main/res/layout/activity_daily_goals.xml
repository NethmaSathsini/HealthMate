
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Page Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Daily Goals"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#183153" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Track your daily progress"
            android:textSize="14sp"
            android:textColor="#64748B"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp" />

        <!-- Today's Records Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_summary_card"
            android:padding="18dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TODAY'S RECORDS"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#64748B" />

            <TextView
                android:id="@+id/tvTodayRecords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 records"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#183153"
                android:layout_marginTop="12dp" />

        </LinearLayout>

        <!-- Daily Goals Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Daily Goals"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#183153"
            android:layout_marginBottom="12dp" />

        <!-- Goal Cards Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="20dp">

            <!-- Step Goal -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_summary_card"
                android:padding="14dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="STEP GOAL"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#15803D" />

                <TextView
                    android:id="@+id/tvStepGoalProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#183153"
                    android:layout_marginTop="10dp" />

                <ProgressBar
                    android:id="@+id/progressStepGoal"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#15803D"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/tvStepGoalDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0 / 8,000 steps"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- Water Goal -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_summary_card"
                android:padding="14dp"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="WATER GOAL"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#0284C7" />

                <TextView
                    android:id="@+id/tvWaterGoalProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#183153"
                    android:layout_marginTop="10dp" />

                <ProgressBar
                    android:id="@+id/progressWaterGoal"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#0284C7"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/tvWaterGoalDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0 / 2,000 ml"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Change Goals Button -->
        <Button
            android:id="@+id/btnChangeGoals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set / Change Daily Goals"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>
