
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_summary_card">

    <!-- Record Date -->
    <TextView
        android:id="@+id/tvRecordDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Date: 2026-10-26"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#183153"
        android:layout_marginBottom="14dp" />

    <!-- Steps -->
    <TextView
        android:id="@+id/tvRecordSteps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Steps: 5000"
        android:textSize="16sp"
        android:textColor="#334155"
        android:layout_marginBottom="8dp" />

    <!-- Calories -->
    <TextView
        android:id="@+id/tvRecordCalories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calories: 250 kcal"
        android:textSize="16sp"
        android:textColor="#334155"
        android:layout_marginBottom="8dp" />

    <!-- Water -->
    <TextView
        android:id="@+id/tvRecordWater"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Water: 1500 ml"
        android:textSize="16sp"
        android:textColor="#334155"
        android:layout_marginBottom="16dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEditRecord"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit"
            android:textAllCaps="false"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnDeleteRecord"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Delete"
            android:textAllCaps="false"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>
