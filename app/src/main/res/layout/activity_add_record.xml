
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Page Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Health Record"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#183153"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter your daily health activities"
            android:textSize="14sp"
            android:textColor="#64748B"
            android:layout_marginBottom="28dp" />

        <!-- Date -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#183153" />

        <EditText
            android:id="@+id/etDate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Select date"
            android:drawableEnd="@drawable/ic_calendar"
            android:drawablePadding="12dp"
            android:textColor="#183153"
            android:textColorHint="#64748B"
            android:textSize="16sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_input_field"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp" />

        <!-- Steps -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Steps Walked"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#183153" />

        <EditText
            android:id="@+id/etSteps"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Enter steps"
            android:textColor="#183153"
            android:textColorHint="#64748B"
            android:textSize="16sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_input_field"
            android:inputType="number"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp" />

        <!-- Calories -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calories Burned"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#183153" />

        <EditText
            android:id="@+id/etCalories"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Enter calories (kcal)"
            android:textColor="#183153"
            android:textColorHint="#64748B"
            android:textSize="16sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_input_field"
            android:inputType="number"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp" />

        <!-- Water -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Water Intake (ml)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#183153" />

        <EditText
            android:id="@+id/etWater"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Enter water intake"
            android:textColor="#183153"
            android:textColorHint="#64748B"
            android:textSize="16sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_input_field"
            android:inputType="number"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="30dp" />

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Record"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>
