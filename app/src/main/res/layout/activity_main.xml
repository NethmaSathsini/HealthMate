
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HealthMate"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#183153" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your daily wellness tracker"
            android:textSize="14sp"
            android:textColor="#64748B"
            android:layout_marginTop="4dp" />

        <!-- Today's Summary -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Today's Summary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#183153"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp" />

        <!-- Steps Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_summary_card"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_steps"
                    android:contentDescription="@string/steps_icon_description" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STEPS WALKED"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#15803D"
                    android:layout_marginStart="10dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 steps"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#183153"
                android:layout_marginTop="12dp" />

        </LinearLayout>

        <!-- Calories Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_summary_card"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_calories"
                    android:contentDescription="@string/calories_icon_description" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CALORIES BURNED"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#DC2626"
                    android:layout_marginStart="10dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvCalories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 kcal"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#183153"
                android:layout_marginTop="12dp" />

        </LinearLayout>

        <!-- Water Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_summary_card"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_water"
                    android:contentDescription="@string/water_icon_description" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WATER INTAKE"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#0284C7"
                    android:layout_marginStart="10dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvWater"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 ml"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#183153"
                android:layout_marginTop="12dp" />

        </LinearLayout>

        <!-- Add Record Button -->
        <Button
            android:id="@+id/btnAddRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Health Record"
            android:textAllCaps="false"
            android:layout_marginTop="20dp" />

        <!-- View Records Button -->
        <Button
            android:id="@+id/btnViewRecords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Health Records"
            android:textAllCaps="false"
            android:layout_marginTop="12dp" />


        <!-- My Daily Goals Button -->
        <Button
            android:id="@+id/btnDailyGoals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Daily Goals"
            android:textAllCaps="false"
            android:layout_marginTop="12dp" />


    </LinearLayout>

</ScrollView>
